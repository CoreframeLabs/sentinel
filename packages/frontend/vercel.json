{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://sentinel-qpwf.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://sentinel-qpwf.onrender.com/health"
    },
    { "source": "/((?!api|health).*)", "destination": "/index.html" }
  ]
}
