# Sentinel backend configuration.
# Every variable is required at startup unless marked optional; the server
# exits with code 1 if a required variable is missing. There are no defaults
# for secrets.

# PostgreSQL connection string.
DATABASE_URL=

# Session signing secret. Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# development | production | test
NODE_ENV=development

# Origin of the deployed frontend, used for CORS. Optional in development
# (defaults to http://localhost:5173), required in production.
FRONTEND_URL=

# Optional, defaults to 3000.
PORT=3000

# --- Bounded AI review (Feature is off unless BOTH this deployment flag and
# --- the per-organisation admin toggle are enabled.) ---

# Deployment-level switch for the AI review feature. Optional, defaults to
# "false". When "true", OPENAI_API_KEY becomes required at startup.
AI_FEATURE_ENABLED=false

# OpenAI API key. Required when AI_FEATURE_ENABLED=true; the server exits 1
# at startup if it is missing. Never logged.
OPENAI_API_KEY=

# Model used for AI evidence review. Optional, defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Timeout for each OpenAI API call in milliseconds. Optional, defaults to
# 30000 (30 seconds). A timed-out call returns 503 and records an error
# interaction.
AI_REQUEST_TIMEOUT_MS=30000

# Demo deployment. When "true", dashboards show a role-aware "you are X, try
# this" scenario card to orient first-time visitors. Optional, defaults to
# "false" — leave it off for real customer deployments.
DEMO_MODE=false
